# Copy this file to `.env` for local development (and add the same
# variables as "Secrets" in your Hugging Face Space's settings for
# deployment — never commit a real .env file).
#
# You only need ONE of GEMINI_API_KEY or GROQ_API_KEY. If you set
# neither, the app still runs completely — src/llm_factory.py falls back
# to a fully offline, zero-cost mock mode so the public demo never
# breaks for a visitor without a key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
